  <script>
    // =========================================================================
    // STATE & GLOBAL CONFIG (Exact Excel defaults by default)
    // =========================================================================
    let currentStep = 1;
    let activeInputId = 'cust-length';
    let selectedShiftHours = 5;
    let isAdminAuthenticated = false;
    let cashflowChartInstance = null;

    let config = {
      pctCooled: 0.15,         // C15: 15% commodity cooled/day
      dTCommodity: 5.0,        // C16: 5 K
      cpCommodity: 4.0,        // C17: 4.0 kJ/kg.K
      perspirationRate: 0.0,   // C21: 0 kJ/kg
      kWallRoof: 0.30,         // C31: 0.3 W/m2K
      kFloor: 0.28,            // C37: 0.28 W/m2K
      lightKw: 0.4,            // C42: 0.4 kW
      lightHrs: 14.0,          // C43: 14 hrs
      doorKjFactor: 30.0,      // C49: 30 kJ/K (Exact Excel value)
      humanCount: 2,           // C54: 2 people
      humanHrs: 5,             // C55: 5 hrs
      humanKw: 0.27,           // C56: 0.27 kW
      safetyFactor: 0.10,      // C62: 10%
      copBase: 1.6,            // C67: 1.6
      pPeak: 5964.2,           // C73: 5422 * 1.1
      pStd: 3467.2,            // C74: 3152 * 1.1
      pOff: 2109.8,            // C75: 1918 * 1.1
      batSpecKwhKg: 0.087,     // C4 (Case 1): 0.087 kWh/kg
      batUnitKg: 2.6,          // C7 (Case 1): 2.6 kg/pack
      batUnitPrice: 140800,    // C10 (Case 1): 128000 * 1.1
      iotCost: 22000000,       // C12 (Case 1): 20M * 1.1
      batShipRate: 3000,       // C13 (Case 1): 3000 VND/kg
      frameCost: 12128600,     // C16 (Case 1): 12,128,600 VND
      frameShip: 5000000,      // C17 (Case 1): 5,000,000 VND
      penjicoPct: 0.50,        // C19 (Case 1): 0.5 (Exact Excel value)
      markupPct: 0.10,         // C24 (Case 1): 0.1
      includeFrameShip: false, // Exact Excel C23 = SUM(C14,C21)
      roundUpBat: false        // Exact Excel C7 = C6/2.6
    };

    const fmtVND = (n) => Math.round(n).toLocaleString('vi-VN');

    // =========================================================================
    // CORE THERMODYNAMIC & FINANCIAL ENGINE (Matches Excel 100%)
    // =========================================================================
    function runEngineeringCalculation(params) {
      const L = params.L;
      const W = params.W;
      const H = params.H;
      const volume = Math.round(L * W * H);
      const areaWallsRoof = L * W + 2 * L * H + 2 * W * H;
      const areaFloor = L * W;
      const dT = params.dT;

      // 1 & 2: Commodity heat loss (Hidden formulas for customer)
      const qComm1 = (params.capacity * params.pctCooled * params.dTCommodity * params.cpCommodity) / 3600;
      const qComm2 = (params.perspirationRate * params.capacity) / 3600;

      // 3 & 4: Envelope heat leakage
      const qWallsRoof = (areaWallsRoof * dT * params.kWallRoof / 1000) * 24;
      const qFloor = (areaFloor * dT * params.kFloor / 1000) * 24;

      // 5, 6, 7: Internal & Door opening loads
      const qLight = 1 * params.lightKw * params.lightHrs;
      const doorVol = volume * 0.5;
      const qDoor = (params.doorOpenings * doorVol * params.doorKjFactor * dT) / 3600;
      const qHuman = params.humanCount * params.humanHrs * params.humanKw;

      const qSum = qComm1 + qComm2 + qWallsRoof + qFloor + qLight + qDoor + qHuman;
      const qTotal = qSum * (1 + params.safetyFactor);

      // Equipment & Efficiency multipliers
      let copEff = params.cop;
      if (params.equip === 'hfc_35') copEff *= 0.85;
      else if (params.equip === 'hfc_25') copEff *= 0.95;
      else if (params.equip === 'nh3_1stage') copEff *= 1.12;
      else if (params.equip === 'nh3_2stage') copEff *= 1.30;

      if (params.cond === 'water') copEff *= 1.08;
      else if (params.cond === 'air') copEff *= 0.94;

      let defrostBonus = 0;
      if (params.defrost === 'electric') defrostBonus = 0.025;
      if (params.solar === 'yes') defrostBonus += 0.04;

      // Electrical consumption
      const eDay = qTotal / copEff;
      const eMonth = eDay * 30;

      // Baseline EVN Cost (24 weekdays + 4 Sundays = 28 days/month as in Excel C89)
      const costWd = (eDay / 24) * (5 * params.pPeak + 13 * params.pStd + 6 * params.pOff);
      const costSun = (eDay / 24) * (18 * params.pStd + 6 * params.pOff);
      const costBaseMonth = costWd * 24 + costSun * 4;
      const costBaseYear = costBaseMonth * 12;

      // Case I: Peak shifting savings
      const shiftHrs = params.shiftHours;
      const pctDemandMet = shiftHrs / 24;

      const peakHrsShifted = Math.min(shiftHrs, 5);
      const stdHrsShifted = Math.max(0, shiftHrs - 5);
      const ePeakShift = eDay * (peakHrsShifted / 24);
      const eStdShift = eDay * (stdHrsShifted / 24);

      const tariffSavingsWd = ePeakShift * (params.pPeak - params.pOff) + eStdShift * (params.pStd - params.pOff);
      const efficiencyBonusYear = costBaseYear * defrostBonus;
      const savingsYear = tariffSavingsWd * 24 * 12 + efficiencyBonusYear;
      const pctSavings = costBaseYear > 0 ? (savingsYear / costBaseYear) : 0;

      // CAPEX Calculation (Sheet Case 1_5 hrs)
      const qPcmDay = qTotal * pctDemandMet;
      const batKwhReq = qPcmDay * 1.1;
      const batWeightRaw = batKwhReq / params.batSpecKwhKg;
      const batCountRaw = batWeightRaw / params.batUnitKg;
      const batCount = params.roundUpBat ? Math.ceil(batCountRaw) : batCountRaw;
      const batWeight = params.roundUpBat ? (batCount * params.batUnitKg) : batWeightRaw;

      const capexBat = batCount * params.batUnitPrice;
      const shipBat = batWeight * params.batShipRate;
      const totalVox = capexBat + params.iotCost + shipBat;

      const capexPrePenjico = totalVox + params.frameCost + params.frameShip;
      const penjicoFee = capexPrePenjico * params.penjicoPct;
      const totalPenjico = params.frameCost + penjicoFee;

      const quotePreMarkup = totalVox + totalPenjico + (params.includeFrameShip ? params.frameShip : 0);
      const finalQuote = quotePreMarkup * (1 + params.markupPct);
      const paybackYears = savingsYear > 0 ? (finalQuote / savingsYear) : 99;

      return {
        volume, qComm1, qComm2, qWallsRoof, qFloor, qLight, qDoor, qHuman,
        qSum, qTotal, eDay, eMonth, costBaseMonth, costBaseYear,
        savingsYear, pctSavings, batKwhReq, batWeight, batCount,
        totalVox, totalPenjico, finalQuote, paybackYears
      };
    }

    // =========================================================================
    // CUSTOMER WIZARD LOGIC
    // =========================================================================
    const stepTitles = {
      1: 'Bước 1: Kích thước & Nhiệt độ vận hành kho',
      2: 'Bước 2: Quy mô hàng hóa & Tần suất mở cửa',
      3: 'Bước 3: Cấu hình Hệ thống lạnh hiện hữu',
      4: 'Bước 4: Thời gian cắt tải cao điểm & Điện mặt trời',
      5: 'Bước 5: Biểu giá điện áp dụng',
      6: 'Kết quả Ước tính Tiết kiệm Năng lượng'
    };

    function goToStep(step) {
      currentStep = step;
      for (let i = 1; i <= 6; i++) {
        const el = document.getElementById(`step-${i}`);
        if (el) el.classList.toggle('hidden', i !== step);
        const nav = document.getElementById(`nav-step-${i}`);
        if (nav) nav.classList.toggle('step-active', i === step);
      }
      document.getElementById('step-title').textContent = stepTitles[step] || '';
      document.getElementById('wizard-footer').classList.toggle('hidden', step === 6);
      document.getElementById('btn-next').textContent = (step === 5) ? 'CALCULATE SAVINGS' : 'NEXT';
    }

    function nextStep() {
      if (currentStep < 5) goToStep(currentStep + 1);
      else if (currentStep === 5) calculateAndShowResult();
    }

    function prevStep() {
      if (currentStep > 1) goToStep(currentStep - 1);
    }

    function resetCustomerForm() {
      document.getElementById('cust-length').value = '2.5';
      document.getElementById('cust-width').value = '2.0';
      document.getElementById('cust-height').value = '1.6';
      document.getElementById('cust-temp').value = '-18';
      document.getElementById('cust-capacity').value = '0';
      document.getElementById('cust-door-openings').value = '10';
      selectShiftHours(5);
      updateLiveVolume();
      goToStep(1);
    }

    function selectRoomType(type) {
      const fBtn = document.getElementById('btn-type-freezer');
      const cBtn = document.getElementById('btn-type-chiller');
      if (type === 'freezer') {
        fBtn.className = 'py-2.5 px-4 rounded-lg border-2 border-emerald-500 bg-emerald-50 text-emerald-800 font-semibold text-sm text-left flex items-center justify-between';
        cBtn.className = 'py-2.5 px-4 rounded-lg border-2 border-slate-200 bg-white text-slate-600 font-semibold text-sm text-left flex items-center justify-between';
        document.getElementById('cust-temp').value = '-18';
      } else {
        cBtn.className = 'py-2.5 px-4 rounded-lg border-2 border-emerald-500 bg-emerald-50 text-emerald-800 font-semibold text-sm text-left flex items-center justify-between';
        fBtn.className = 'py-2.5 px-4 rounded-lg border-2 border-slate-200 bg-white text-slate-600 font-semibold text-sm text-left flex items-center justify-between';
        document.getElementById('cust-temp').value = '2';
      }
    }

    function updateLiveVolume() {
      const L = parseFloat(document.getElementById('cust-length').value) || 0;
      const W = parseFloat(document.getElementById('cust-width').value) || 0;
      const H = parseFloat(document.getElementById('cust-height').value) || 0;
      document.getElementById('live-volume-display').textContent = (L * W * H).toFixed(1) + ' m³';
      document.getElementById('live-area-display').textContent = (L * W).toFixed(1) + ' m²';
    }

    function pressNumpad(key) {
      const input = document.getElementById(activeInputId);
      if (!input) return;
      let val = input.value.toString();
      if (key === 'DEL') {
        input.value = val.slice(0, -1);
      } else if (key === '.') {
        if (!val.includes('.')) input.value = val + '.';
      } else {
        input.value = (val === '0' ? '' : val) + key;
      }
      updateLiveVolume();
    }

    function selectShiftHours(hrs) {
      selectedShiftHours = hrs;
      [5, 8, 10].forEach(h => {
        const btn = document.getElementById(`btn-hrs-${h}`);
        btn.className = (h === hrs)
          ? 'hrs-btn py-3 px-4 rounded-xl border-2 border-emerald-500 bg-emerald-50 text-emerald-800 font-bold text-center'
          : 'hrs-btn py-3 px-4 rounded-xl border-2 border-slate-200 bg-white text-slate-700 font-bold text-center';
      });
    }

    function selectTariffPreset(preset) {
      if (preset === 'commercial_lt6') {
        config.pPeak = 5964.2; config.pStd = 3467.2; config.pOff = 2109.8;
      } else {
        config.pPeak = 3640.0; config.pStd = 1997.0; config.pOff = 1304.0;
      }
    }

    let lastCustomerResult = null;

    function calculateAndShowResult() {
      const L = parseFloat(document.getElementById('cust-length').value) || 2.5;
      const W = parseFloat(document.getElementById('cust-width').value) || 2.0;
      const H = parseFloat(document.getElementById('cust-height').value) || 1.6;
      const temp = parseFloat(document.getElementById('cust-temp').value);
      const dT = isNaN(temp) ? 60 : Math.max(10, 35 - temp + (temp <= -18 ? 7 : 0)); // Matches 60K at -18C
      const capacity = parseFloat(document.getElementById('cust-capacity').value) || 0;
      const doorOpenings = parseFloat(document.getElementById('cust-door-openings').value) || 10;
      const equip = document.querySelector('input[name="cust-equip"]:checked').value;
      const cond = document.querySelector('input[name="cust-cond"]:checked').value;
      const defrost = document.querySelector('input[name="cust-defrost"]:checked').value;
      const solar = document.querySelector('input[name="cust-solar"]:checked').value;

      const res = runEngineeringCalculation({
        ...config,
        L, W, H, dT, capacity, doorOpenings,
        equip, cond, defrost, solar,
        shiftHours: selectedShiftHours,
        cop: config.copBase
      });

      lastCustomerResult = { L, W, H, dT, capacity, doorOpenings, res };

      document.getElementById('res-pct-circle').textContent = (res.pctSavings * 100).toFixed(1) + '%';
      document.getElementById('res-pct-text').innerHTML = '&darr; ' + (res.pctSavings * 100).toFixed(1) + '%';
      document.getElementById('res-base-kwh').textContent = Math.round(res.eMonth).toLocaleString('vi-VN');
      document.getElementById('res-annual-savings').innerHTML = '&darr; ' + fmtVND(res.savingsYear) + ' đ';
      document.getElementById('res-total-quote').textContent = fmtVND(res.finalQuote) + ' đ';
      document.getElementById('res-payback').textContent = `Hoàn vốn dự kiến: ~${res.paybackYears.toFixed(1)} năm`;

      goToStep(6);
    }

    function submitCustomerLead() {
      const name = document.getElementById('lead-name').value.trim();
      const company = document.getElementById('lead-company').value.trim();
      const contact = document.getElementById('lead-contact').value.trim();
      const msgEl = document.getElementById('lead-msg');

      if (!name || !contact) {
        msgEl.textContent = 'Vui lòng nhập Họ tên và Số điện thoại / Email để nhận báo cáo.';
        msgEl.classList.remove('hidden');
        return;
      }

      const leads = JSON.parse(localStorage.getItem('voxcool_leads') || '[]');
      leads.unshift({
        id: Date.now(),
        time: new Date().toLocaleString('vi-VN'),
        name, company: company || 'Chưa cung cấp', contact,
        data: lastCustomerResult
      });
      localStorage.setItem('voxcool_leads', JSON.stringify(leads));
      renderLeadsTable();

      msgEl.textContent = 'Đã ghi nhận thông tin! Đội ngũ kỹ thuật VOX Cool sẽ gửi báo cáo chi tiết cho bạn.';
      msgEl.classList.remove('hidden');
    }

    // =========================================================================
    // ADMIN / R&D PORTAL LOGIC
    // =========================================================================
    function openAdminModal() {
      if (isAdminAuthenticated) {
        switchMode('admin');
        return;
      }
      document.getElementById('admin-modal').classList.remove('hidden');
      document.getElementById('admin-pwd-input').focus();
    }

    function closeAdminModal() {
      document.getElementById('admin-modal').classList.add('hidden');
      document.getElementById('admin-login-err').classList.add('hidden');
    }

    function verifyAdminLogin() {
      const pwd = document.getElementById('admin-pwd-input').value;
      if (pwd === 'voxcool2026' || pwd === 'DUCMANH') {
        isAdminAuthenticated = true;
        closeAdminModal();
        switchMode('admin');
        recalcAdmin();
        renderLeadsTable();
      } else {
        document.getElementById('admin-login-err').classList.remove('hidden');
      }
    }

    function switchMode(mode) {
      const isCust = mode === 'customer';
      document.getElementById('view-customer').classList.toggle('hidden', !isCust);
      document.getElementById('view-admin').classList.toggle('hidden', isCust);

      document.getElementById('btn-switch-customer').className = isCust
        ? 'px-3.5 py-1.5 rounded-md text-sm font-semibold bg-emerald-500 text-slate-950 shadow transition'
        : 'px-3.5 py-1.5 rounded-md text-sm font-semibold bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 transition';

      document.getElementById('btn-switch-admin').className = !isCust
        ? 'px-3.5 py-1.5 rounded-md text-sm font-semibold bg-emerald-500 text-slate-950 shadow transition flex items-center gap-1.5'
        : 'px-3.5 py-1.5 rounded-md text-sm font-semibold bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 transition flex items-center gap-1.5';
    }

    function switchAdminTab(tab) {
      ['calc', 'cashflow', 'leads'].forEach(t => {
        document.getElementById(`admin-panel-${t}`).classList.toggle('hidden', t !== tab);
        const btn = document.getElementById(`admin-tab-${t}`);
        btn.className = (t === tab)
          ? 'py-3 px-4 text-sm font-bold border-b-2 border-emerald-600 text-emerald-700 flex items-center gap-1.5'
          : 'py-3 px-4 text-sm font-semibold text-slate-500 hover:text-slate-800 flex items-center gap-1.5';
      });
      if (tab === 'cashflow') recalcAdmin();
    }

    function resetAdminToExcelDefaults(rawExcelMode) {
      document.getElementById('adm-L').value = 2.5;
      document.getElementById('adm-W').value = 2.0;
      document.getElementById('adm-H').value = 1.6;
      document.getElementById('adm-dT').value = 60;
      document.getElementById('adm-cap').value = 0;
      document.getElementById('adm-pct-cool').value = 0.15;
      document.getElementById('adm-dT-comm').value = 5;
      document.getElementById('adm-cp-comm').value = 4.0;
      document.getElementById('adm-persp').value = 0;
      document.getElementById('adm-k-wall').value = 0.30;
      document.getElementById('adm-k-floor').value = 0.28;
      document.getElementById('adm-light-kw').value = 0.4;
      document.getElementById('adm-light-hrs').value = 14;
      document.getElementById('adm-human-cnt').value = 2;
      document.getElementById('adm-human-hrs').value = 5;
      document.getElementById('adm-safety').value = 10;
      document.getElementById('adm-cop').value = 1.6;
      document.getElementById('adm-shift-hrs').value = 5;
      document.getElementById('adm-door-kj').value = 30;

      if (rawExcelMode) {
        document.getElementById('adm-penjico-pct').value = 50;
        config.includeFrameShip = false;
        config.roundUpBat = false;
      } else {
        document.getElementById('adm-penjico-pct').value = 5;
        config.includeFrameShip = true;
        config.roundUpBat = true;
      }
      recalcAdmin();
    }

    function recalcAdmin() {
      config.pctCooled = parseFloat(document.getElementById('adm-pct-cool').value) || 0.15;
      config.dTCommodity = parseFloat(document.getElementById('adm-dT-comm').value) || 5;
      config.cpCommodity = parseFloat(document.getElementById('adm-cp-comm').value) || 4.0;
      config.perspirationRate = parseFloat(document.getElementById('adm-persp').value) || 0;
      config.kWallRoof = parseFloat(document.getElementById('adm-k-wall').value) || 0.30;
      config.kFloor = parseFloat(document.getElementById('adm-k-floor').value) || 0.28;
      config.lightKw = parseFloat(document.getElementById('adm-light-kw').value) || 0.4;
      config.lightHrs = parseFloat(document.getElementById('adm-light-hrs').value) || 14;
      config.doorKjFactor = parseFloat(document.getElementById('adm-door-kj').value) || 30;
      config.humanCount = parseFloat(document.getElementById('adm-human-cnt').value) || 0;
      config.humanHrs = parseFloat(document.getElementById('adm-human-hrs').value) || 0;
      config.safetyFactor = (parseFloat(document.getElementById('adm-safety').value) || 0) / 100;
      config.copBase = parseFloat(document.getElementById('adm-cop').value) || 1.6;
      config.pPeak = parseFloat(document.getElementById('adm-p-peak').value) || 5964.2;
      config.pStd = parseFloat(document.getElementById('adm-p-std').value) || 3467.2;
      config.pOff = parseFloat(document.getElementById('adm-p-off').value) || 2109.8;

      config.batSpecKwhKg = parseFloat(document.getElementById('adm-bat-spec').value) || 0.087;
      config.batUnitKg = parseFloat(document.getElementById('adm-bat-kg').value) || 2.6;
      config.batUnitPrice = parseFloat(document.getElementById('adm-bat-price').value) || 140800;
      config.iotCost = parseFloat(document.getElementById('adm-iot-cost').value) || 0;
      config.batShipRate = parseFloat(document.getElementById('adm-bat-ship-rate').value) || 0;
      config.frameCost = parseFloat(document.getElementById('adm-frame-cost').value) || 0;
      config.frameShip = parseFloat(document.getElementById('adm-frame-ship').value) || 0;
      config.penjicoPct = (parseFloat(document.getElementById('adm-penjico-pct').value) || 0) / 100;
      config.markupPct = (parseFloat(document.getElementById('adm-markup-pct').value) || 0) / 100;

      const L = parseFloat(document.getElementById('adm-L').value) || 2.5;
      const W = parseFloat(document.getElementById('adm-W').value) || 2.0;
      const H = parseFloat(document.getElementById('adm-H').value) || 1.6;
      const dT = parseFloat(document.getElementById('adm-dT').value) || 60;
      const capacity = parseFloat(document.getElementById('adm-cap').value) || 0;
      const doorOpenings = parseFloat(document.getElementById('adm-door-cnt').value) || 10;
      const shiftHours = parseFloat(document.getElementById('adm-shift-hrs').value) || 5;

      const res = runEngineeringCalculation({
        ...config, L, W, H, dT, capacity, doorOpenings,
        equip: 'unknown', cond: 'unknown', defrost: 'unknown', solar: 'unknown',
        shiftHours, cop: config.copBase
      });

      document.getElementById('out-q-comm').textContent = (res.qComm1 + res.qComm2).toFixed(2);
      document.getElementById('out-q-env').textContent = (res.qWallsRoof + res.qFloor).toFixed(2);
      document.getElementById('out-q-int').textContent = (res.qLight + res.qDoor + res.qHuman).toFixed(2);
      document.getElementById('out-q-total').textContent = res.qTotal.toFixed(2) + ' kWh/ngày';
      document.getElementById('out-e-month').textContent = res.eMonth.toFixed(1) + ' kWh/tháng';
      document.getElementById('out-save-year').textContent = `${fmtVND(res.savingsYear)} đ/năm (${(res.pctSavings*100).toFixed(1)}%)`;

      document.getElementById('out-bat-kwh').textContent = res.batKwhReq.toFixed(2) + ' kWh';
      document.getElementById('out-bat-weight').textContent = res.batWeight.toFixed(2) + ' kg';
      document.getElementById('out-bat-count').textContent = (config.roundUpBat ? res.batCount : res.batCount.toFixed(2)) + ' viên';

      document.getElementById('out-vox-cost').textContent = fmtVND(res.totalVox) + ' đ';
      document.getElementById('out-penjico-cost').textContent = fmtVND(res.totalPenjico) + ' đ';
      document.getElementById('out-final-quote').textContent = fmtVND(res.finalQuote) + ' đ';
      document.getElementById('out-adm-payback').textContent = res.paybackYears.toFixed(2) + ' năm';

      updateCashflowAndSensitivity(res);
    }

    function updateCashflowAndSensitivity(res) {
      const opexPct = (parseFloat(document.getElementById('adm-opex-pct').value) || 0) / 100;
      const infPct = (parseFloat(document.getElementById('adm-inf-pct').value) || 0) / 100;
      const discPct = (parseFloat(document.getElementById('adm-disc-pct').value) || 0) / 100;

      const tbody = document.getElementById('sensitivity-tbody');
      tbody.innerHTML = '';
      [0.05, 0.10, 0.15, 0.20, 0.25, 0.30, 0.35].forEach(pct => {
        const annSave = res.costBaseYear * pct;
        const pb = annSave > 0 ? (res.finalQuote / annSave) : 99;
        tbody.innerHTML += `
          <tr class="${Math.abs(pct - 0.20) < 0.01 ? 'bg-emerald-50 font-semibold' : ''}">
            <td class="p-2">${(pct * 100).toFixed(0)}%</td>
            <td class="p-2 text-right">${fmtVND(annSave)} đ</td>
            <td class="p-2 text-right text-emerald-700 font-bold">${pb.toFixed(1)} năm</td>
          </tr>
        `;
      });

      const labels = [];
      const cumData = [];
      let cum = 0;
      const cfs = [];

      for (let yr = 1; yr <= 10; yr++) {
        labels.push('Năm ' + yr);
        const capexYr = yr === 1 ? res.finalQuote : 0;
        const opexYr = (res.finalQuote * opexPct) * Math.pow(1 + infPct, yr - 1);
        const benefitYr = res.savingsYear * Math.pow(1 + infPct, yr - 1);
        const netCf = benefitYr - capexYr - opexYr;
        cfs.push(netCf);
        const discCf = netCf / Math.pow(1 + discPct, yr - 1);
        cum += discCf;
        cumData.push(Math.round(cum));
      }

      let irr = 0.05;
      for (let i = 0; i < 50; i++) {
        let npv = 0, dNpv = 0;
        for (let t = 0; t < cfs.length; t++) {
          npv += cfs[t] / Math.pow(1 + irr, t);
          if (t > 0) dNpv -= t * cfs[t] / Math.pow(1 + irr, t + 1);
        }
        if (Math.abs(dNpv) < 1e-6) break;
        irr = irr - npv / dNpv;
      }
      document.getElementById('out-adm-irr').textContent = isFinite(irr) ? (irr * 100).toFixed(1) + '%' : 'N/A';

      const ctx = document.getElementById('cashflowChart').getContext('2d');
      if (cashflowChartInstance) cashflowChartInstance.destroy();
      cashflowChartInstance = new Chart(ctx, {
        type: 'bar',
        data: {
          labels,
          datasets: [{
            label: 'Dòng tiền lũy kế chiết khấu (VND)',
            data: cumData,
            backgroundColor: cumData.map(v => v >= 0 ? '#10b981' : '#f43f5e'),
            borderRadius: 4
          }]
        },
        options: {
          responsive: true,
          plugins: { legend: { display: true } },
          scales: {
            y: { ticks: { callback: (v) => (v / 1e6).toFixed(0) + ' Tr' } }
          }
        }
      });
    }

    function renderLeadsTable() {
      const leads = JSON.parse(localStorage.getItem('voxcool_leads') || '[]');
      document.getElementById('lead-count-badge').textContent = leads.length;
      const tbody = document.getElementById('leads-tbody');
      if (leads.length === 0) {
        tbody.innerHTML = '<tr><td colspan="7" class="p-6 text-center text-slate-400">Chưa có khách hàng nào gửi yêu cầu.</td></tr>';
        return;
      }
      tbody.innerHTML = leads.map((l, idx) => `
        <tr class="hover:bg-slate-50">
          <td class="p-2.5 text-slate-500">${l.time}</td>
          <td class="p-2.5 font-semibold text-slate-800">${l.name} <span class="block text-[11px] font-normal text-slate-500">${l.company}</span></td>
          <td class="p-2.5">${l.contact}</td>
          <td class="p-2.5">${l.data.L}m × ${l.data.W}m × ${l.data.H}m (${l.data.res.volume} m³)</td>
          <td class="p-2.5 text-right text-emerald-700 font-bold">${fmtVND(l.data.res.savingsYear)} đ</td>
          <td class="p-2.5 text-right font-bold">${fmtVND(l.data.res.finalQuote)} đ</td>
          <td class="p-2.5 text-center">
            <button onclick="loadLeadIntoAdmin(${idx})" class="px-2.5 py-1 bg-sky-600 hover:bg-sky-700 text-white rounded text-[11px] font-semibold">
              Nạp vào bảng tính
            </button>
          </td>
        </tr>
      `).join('');
    }

    function loadLeadIntoAdmin(idx) {
      const leads = JSON.parse(localStorage.getItem('voxcool_leads') || '[]');
      const l = leads[idx];
      if (!l) return;
      document.getElementById('adm-L').value = l.data.L;
      document.getElementById('adm-W').value = l.data.W;
      document.getElementById('adm-H').value = l.data.H;
      document.getElementById('adm-dT').value = l.data.dT;
      document.getElementById('adm-cap').value = l.data.capacity;
      document.getElementById('adm-door-cnt').value = l.data.doorOpenings;
      switchAdminTab('calc');
      recalcAdmin();
    }

    function clearAllLeads() {
      localStorage.removeItem('voxcool_leads');
      renderLeadsTable();
    }

    // Khởi tạo mặc định giữ nguyên 100% số gốc trong file Excel
    resetAdminToExcelDefaults(true);
    renderLeadsTable();
  </script>
</body>
