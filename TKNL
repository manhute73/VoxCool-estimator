<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>VOX Cool | Cold Storage Energy Savings Estimator & Admin Portal</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Inter', sans-serif; background-color: #f4f7f9; }
    .numpad-btn { transition: all 0.1s ease; }
    .numpad-btn:active { transform: scale(0.95); background-color: #16a34a; color: white; }
    .step-active { border-left: 4px solid #22c55e; background-color: rgba(34, 197, 94, 0.12); color: #22c55e; }
    input[type="number"]::-webkit-inner-spin-button,
    input[type="number"]::-webkit-outer-spin-button { -webkit-appearance: none; margin: 0; }
  </style>
</head>
<body class="text-slate-800 antialiased">

  <!-- TOP NAVIGATION BAR -->
  <header class="bg-[#0f172a] text-white shadow-md sticky top-0 z-50">
    <div class="max-w-7xl mx-auto px-4 h-16 flex items-center justify-between">
      <div class="flex items-center space-x-3">
        <div class="w-9 h-9 rounded-lg bg-emerald-500 flex items-center justify-center font-extrabold text-slate-950 text-lg shadow">
          V
        </div>
        <div>
          <span class="font-bold tracking-wider text-lg text-white">VOX COOL</span>
          <span class="hidden sm:inline-block text-xs text-emerald-400 font-semibold ml-2 uppercase tracking-widest border-l border-slate-700 pl-2">
            Thermal Energy Storage
          </span>
        </div>
      </div>

      <div class="flex items-center space-x-3">
        <button id="btn-switch-customer" onclick="switchMode('customer')"
          class="px-3.5 py-1.5 rounded-md text-sm font-semibold bg-emerald-500 text-slate-950 shadow transition">
          Giao diện Khách hàng
        </button>
        <button id="btn-switch-admin" onclick="openAdminModal()"
          class="px-3.5 py-1.5 rounded-md text-sm font-semibold bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 transition flex items-center gap-1.5">
          <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
          </svg>
          <span>Admin / R&D</span>
        </button>
      </div>
    </div>
  </header>

  <!-- ===================================================================== -->
  <!-- VIEW 1: CUSTOMER / PARTNER ESTIMATOR (WIZARD UI)                      -->
  <!-- ===================================================================== -->
  <main id="view-customer" class="max-w-5xl mx-auto my-8 px-4">
    <div class="bg-white rounded-2xl shadow-xl overflow-hidden border border-slate-200 min-h-[580px] flex flex-col md:flex-row">
      
      <!-- LEFT SIDEBAR STEPPER -->
      <aside class="w-full md:w-20 bg-[#1e293b] text-slate-400 flex md:flex-col justify-between py-3 md:py-6 px-4 md:px-0 items-center shrink-0">
        <div class="flex md:flex-col gap-2 md:gap-4 w-full justify-around md:justify-start">
          <button onclick="goToStep(1)" id="nav-step-1" class="step-nav p-3 flex flex-col items-center justify-center hover:text-white transition step-active" title="1. Quy mô & Nhiệt độ">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
            <span class="text-[10px] mt-1 font-medium">Kho lạnh</span>
          </button>
          <button onclick="goToStep(2)" id="nav-step-2" class="step-nav p-3 flex flex-col items-center justify-center hover:text-white transition" title="2. Hàng hóa & Hoạt động">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
            <span class="text-[10px] mt-1 font-medium">Hàng hóa</span>
          </button>
          <button onclick="goToStep(3)" id="nav-step-3" class="step-nav p-3 flex flex-col items-center justify-center hover:text-white transition" title="3. Thiết bị máy lạnh">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            <span class="text-[10px] mt-1 font-medium">Hệ lạnh</span>
          </button>
          <button onclick="goToStep(4)" id="nav-step-4" class="step-nav p-3 flex flex-col items-center justify-center hover:text-white transition" title="4. Cắt tải & Điện mặt trời">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
            <span class="text-[10px] mt-1 font-medium">Cắt tải</span>
          </button>
          <button onclick="goToStep(5)" id="nav-step-5" class="step-nav p-3 flex flex-col items-center justify-center hover:text-white transition" title="5. Biểu giá điện EVN">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
            <span class="text-[10px] mt-1 font-medium">Giá điện</span>
          </button>
          <button onclick="calculateAndShowResult()" id="nav-step-6" class="step-nav p-3 flex flex-col items-center justify-center hover:text-white transition" title="6. Kết quả ước tính">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            <span class="text-[10px] mt-1 font-medium">Kết quả</span>
          </button>
        </div>
      </aside>

      <!-- MAIN CONTENT AREA -->
      <div class="flex-1 flex flex-col justify-between bg-white">
        <!-- Top Header inside Card -->
        <div class="px-8 pt-6 pb-4 border-b border-slate-100 flex justify-between items-center">
          <div>
            <p class="text-xs font-bold tracking-widest text-sky-600 uppercase">COLD STORAGE ENERGY SAVINGS ESTIMATOR</p>
            <h1 id="step-title" class="text-xl font-bold text-slate-800 mt-0.5">Bước 1: Kích thước & Nhiệt độ vận hành kho</h1>
          </div>
          <button onclick="resetCustomerForm()" class="px-4 py-1.5 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold tracking-wider uppercase rounded shadow-sm transition">
            RESTART
          </button>
        </div>

        <!-- STEP PANELS -->
        <div class="p-8 flex-1 flex flex-col justify-center">
          
          <!-- STEP 1: DIMENSIONS & TEMPERATURE -->
          <div id="step-1" class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
            <div class="lg:col-span-7 space-y-5">
              <div>
                <label class="block text-sm font-semibold text-slate-700 mb-2">Loại kho lạnh</label>
                <div class="grid grid-cols-2 gap-3">
                  <button type="button" onclick="selectRoomType('freezer')" id="btn-type-freezer"
                    class="py-2.5 px-4 rounded-lg border-2 border-emerald-500 bg-emerald-50 text-emerald-800 font-semibold text-sm text-left flex items-center justify-between">
                    <span>Kho đông (Freezer)</span>
                    <span class="text-xs bg-emerald-200 px-2 py-0.5 rounded">-18°C</span>
                  </button>
                  <button type="button" onclick="selectRoomType('chiller')" id="btn-type-chiller"
                    class="py-2.5 px-4 rounded-lg border-2 border-slate-200 bg-white text-slate-600 font-semibold text-sm text-left flex items-center justify-between">
                    <span>Kho mát (Chiller)</span>
                    <span class="text-xs bg-slate-100 px-2 py-0.5 rounded">+2°C</span>
                  </button>
                </div>
              </div>

              <div>
                <label class="block text-sm font-semibold text-slate-700 mb-2">Kích thước lọt lòng kho (Dài × Rộng × Cao)</label>
                <div class="grid grid-cols-3 gap-3">
                  <div class="relative">
                    <input type="number" step="0.1" id="cust-length" value="2.5" onfocus="activeInputId='cust-length'" oninput="updateLiveVolume()"
                      class="w-full px-3 py-3 text-xl font-bold text-emerald-600 bg-slate-100 border-2 border-emerald-500 rounded-lg focus:outline-none">
                    <span class="absolute right-3 top-3.5 text-sm font-semibold text-slate-500">m (Dài)</span>
                  </div>
                  <div class="relative">
                    <input type="number" step="0.1" id="cust-width" value="2.0" onfocus="activeInputId='cust-width'" oninput="updateLiveVolume()"
                      class="w-full px-3 py-3 text-xl font-bold text-emerald-600 bg-slate-100 border-2 border-transparent focus:border-emerald-500 rounded-lg focus:outline-none">
                    <span class="absolute right-3 top-3.5 text-sm font-semibold text-slate-500">m (Rộng)</span>
                  </div>
                  <div class="relative">
                    <input type="number" step="0.1" id="cust-height" value="1.6" onfocus="activeInputId='cust-height'" oninput="updateLiveVolume()"
                      class="w-full px-3 py-3 text-xl font-bold text-emerald-600 bg-slate-100 border-2 border-transparent focus:border-emerald-500 rounded-lg focus:outline-none">
                    <span class="absolute right-3 top-3.5 text-sm font-semibold text-slate-500">m (Cao)</span>
                  </div>
                </div>
                <p class="text-xs text-slate-500 mt-1.5">Thể tích kho ước tính: <strong id="live-volume-display" class="text-slate-800">8.0 m³</strong> (Diện tích sàn: <strong id="live-area-display" class="text-slate-800">5.0 m²</strong>)</p>
              </div>

              <div>
                <label class="block text-sm font-semibold text-slate-700 mb-1.5">Nhiệt độ cài đặt vận hành kho (°C)</label>
                <div class="relative max-w-xs">
                  <input type="number" step="1" id="cust-temp" value="-18" onfocus="activeInputId='cust-temp'"
                    class="w-full px-4 py-3 text-2xl font-bold text-emerald-600 bg-slate-100 border-2 border-transparent focus:border-emerald-500 rounded-lg focus:outline-none">
                  <span class="absolute right-4 top-3.5 text-lg font-bold text-slate-600">°C</span>
                </div>
              </div>
            </div>

            <!-- KEYPAD -->
            <div class="lg:col-span-5 flex justify-center">
              <div class="grid grid-cols-3 gap-2 w-56 bg-slate-50 p-3 rounded-xl border border-slate-200">
                <button type="button" onclick="pressNumpad('1')" class="numpad-btn h-12 bg-slate-200 hover:bg-slate-300 rounded font-bold text-slate-700">1</button>
                <button type="button" onclick="pressNumpad('2')" class="numpad-btn h-12 bg-slate-200 hover:bg-slate-300 rounded font-bold text-slate-700">2</button>
                <button type="button" onclick="pressNumpad('3')" class="numpad-btn h-12 bg-slate-200 hover:bg-slate-300 rounded font-bold text-slate-700">3</button>
                <button type="button" onclick="pressNumpad('4')" class="numpad-btn h-12 bg-slate-200 hover:bg-slate-300 rounded font-bold text-slate-700">4</button>
                <button type="button" onclick="pressNumpad('5')" class="numpad-btn h-12 bg-slate-200 hover:bg-slate-300 rounded font-bold text-slate-700">5</button>
                <button type="button" onclick="pressNumpad('6')" class="numpad-btn h-12 bg-slate-200 hover:bg-slate-300 rounded font-bold text-slate-700">6</button>
                <button type="button" onclick="pressNumpad('7')" class="numpad-btn h-12 bg-slate-200 hover:bg-slate-300 rounded font-bold text-slate-700">7</button>
                <button type="button" onclick="pressNumpad('8')" class="numpad-btn h-12 bg-slate-200 hover:bg-slate-300 rounded font-bold text-slate-700">8</button>
                <button type="button" onclick="pressNumpad('9')" class="numpad-btn h-12 bg-slate-200 hover:bg-slate-300 rounded font-bold text-slate-700">9</button>
                <button type="button" onclick="pressNumpad('.')" class="numpad-btn h-12 bg-slate-200 hover:bg-slate-300 rounded font-bold text-slate-700">.</button>
                <button type="button" onclick="pressNumpad('0')" class="numpad-btn h-12 bg-slate-200 hover:bg-slate-300 rounded font-bold text-slate-700">0</button>
                <button type="button" onclick="pressNumpad('DEL')" class="numpad-btn h-12 bg-slate-900 hover:bg-slate-800 text-white rounded font-bold text-xs">DEL</button>
              </div>
            </div>
          </div>

          <!-- STEP 2: COMMODITY & DAILY OPERATIONS (Formulas completely hidden from customer) -->
          <div id="step-2" class="hidden space-y-6 max-w-2xl">
            <div>
              <label class="block text-base font-bold text-slate-800 mb-2">1. Sức chứa hàng hóa của kho (Capacity of Cold Room)</label>
              <p class="text-xs text-slate-500 mb-2">Chỉ cần nhập tổng khối lượng hàng hóa chứa trong kho (kg), hệ thống tự động tính toán phụ tải nhiệt làm lạnh sản phẩm.</p>
              <div class="relative max-w-sm">
                <input type="number" id="cust-capacity" value="0" placeholder="Ví dụ: 2000"
                  class="w-full px-4 py-3 text-xl font-bold text-emerald-600 bg-slate-100 border-2 border-slate-200 focus:border-emerald-500 rounded-lg focus:outline-none">
                <span class="absolute right-4 top-3.5 text-base font-bold text-slate-600">kg</span>
              </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div>
                <label class="block text-sm font-bold text-slate-800 mb-2">2. Nhóm hàng hóa bảo quản</label>
                <select id="cust-product-type" class="w-full px-4 py-3 bg-slate-100 border border-slate-200 rounded-lg font-medium text-slate-700 focus:outline-none focus:border-emerald-500">
                  <option value="frozen_meat">Thủy hải sản / Thịt cấp đông</option>
                  <option value="processed">Thực phẩm chế biến / Kem / Sữa</option>
                  <option value="produce">Rau củ quả / Nông sản</option>
                  <option value="unknown" selected>Chưa có thông tin / Hỗn hợp</option>
                </select>
              </div>

              <div>
                <label class="block text-sm font-bold text-slate-800 mb-2">3. Số lần mở cửa kho mỗi ngày</label>
                <input type="number" id="cust-door-openings" value="10" min="0" max="200"
                  class="w-full px-4 py-3 text-lg font-bold text-emerald-600 bg-slate-100 border border-slate-200 rounded-lg focus:outline-none focus:border-emerald-500">
              </div>
            </div>
          </div>

          <!-- STEP 3: FREEZER EQUIPMENT & CONDENSER -->
          <div id="step-3" class="hidden grid grid-cols-1 md:grid-cols-2 gap-8">
            <div>
              <h3 class="text-base font-bold text-slate-800 mb-3">Hệ thống máy nén lạnh (Freezer Equipment)</h3>
              <div class="space-y-2.5">
                <label class="flex items-center space-x-3 p-3 rounded-lg border border-slate-200 cursor-pointer hover:bg-slate-50">
                  <input type="radio" name="cust-equip" value="hfc_35" class="w-4 h-4 accent-emerald-600">
                  <span class="text-sm font-medium text-slate-700">HFC / Freon 1 cấp / Song song @ -35°C</span>
                </label>
                <label class="flex items-center space-x-3 p-3 rounded-lg border border-slate-200 cursor-pointer hover:bg-slate-50">
                  <input type="radio" name="cust-equip" value="hfc_25" class="w-4 h-4 accent-emerald-600">
                  <span class="text-sm font-medium text-slate-700">HFC / Freon 1 cấp / Song song @ -25°C</span>
                </label>
                <label class="flex items-center space-x-3 p-3 rounded-lg border border-slate-200 cursor-pointer hover:bg-slate-50">
                  <input type="radio" name="cust-equip" value="nh3_1stage" class="w-4 h-4 accent-emerald-600">
                  <span class="text-sm font-medium text-slate-700">Ammonia (NH3) Trục vít 1 cấp</span>
                </label>
                <label class="flex items-center space-x-3 p-3 rounded-lg border border-slate-200 cursor-pointer hover:bg-slate-50">
                  <input type="radio" name="cust-equip" value="nh3_2stage" class="w-4 h-4 accent-emerald-600">
                  <span class="text-sm font-medium text-slate-700">Ammonia (NH3) 2 cấp</span>
                </label>
                <label class="flex items-center space-x-3 p-3 rounded-lg border-2 border-emerald-500 bg-emerald-50/50 cursor-pointer">
                  <input type="radio" name="cust-equip" value="unknown" checked class="w-4 h-4 accent-emerald-600">
                  <span class="text-sm font-bold text-emerald-800">Không rõ (Unknown — Mặc định COP 1.6)</span>
                </label>
              </div>
            </div>

            <div class="space-y-6">
              <div>
                <h3 class="text-base font-bold text-slate-800 mb-3">Loại dàn ngưng (Condenser Type)</h3>
                <div class="space-y-2">
                  <label class="flex items-center space-x-3 p-2.5 rounded-lg border border-slate-200 cursor-pointer">
                    <input type="radio" name="cust-cond" value="water" class="w-4 h-4 accent-emerald-600">
                    <span class="text-sm font-medium text-slate-700">Giải nhiệt nước / Bay hơi (Water Condenser)</span>
                  </label>
                  <label class="flex items-center space-x-3 p-2.5 rounded-lg border border-slate-200 cursor-pointer">
                    <input type="radio" name="cust-cond" value="air" class="w-4 h-4 accent-emerald-600">
                    <span class="text-sm font-medium text-slate-700">Giải nhiệt gió (Air Condenser)</span>
                  </label>
                  <label class="flex items-center space-x-3 p-2.5 rounded-lg border border-slate-200 cursor-pointer">
                    <input type="radio" name="cust-cond" value="unknown" checked class="w-4 h-4 accent-emerald-600">
                    <span class="text-sm font-medium text-slate-700">Không rõ (Unknown)</span>
                  </label>
                </div>
              </div>

              <div>
                <h3 class="text-base font-bold text-slate-800 mb-3">Chế độ xả đá (Defrost Type)</h3>
                <div class="space-y-2">
                  <label class="flex items-center space-x-3 p-2.5 rounded-lg border border-slate-200 cursor-pointer">
                    <input type="radio" name="cust-defrost" value="hotgas" class="w-4 h-4 accent-emerald-600">
                    <span class="text-sm font-medium text-slate-700">Gas nóng (Hot Gas Bypass)</span>
                  </label>
                  <label class="flex items-center space-x-3 p-2.5 rounded-lg border border-slate-200 cursor-pointer">
                    <input type="radio" name="cust-defrost" value="electric" class="w-4 h-4 accent-emerald-600">
                    <span class="text-sm font-medium text-slate-700">Điện trở (Electric Defrost)</span>
                  </label>
                  <label class="flex items-center space-x-3 p-2.5 rounded-lg border border-slate-200 cursor-pointer">
                    <input type="radio" name="cust-defrost" value="unknown" checked class="w-4 h-4 accent-emerald-600">
                    <span class="text-sm font-medium text-slate-700">Không rõ (Unknown)</span>
                  </label>
                </div>
              </div>
            </div>
          </div>

          <!-- STEP 4: PEAK SHIFTING HOURS & SOLAR PV -->
          <div id="step-4" class="hidden space-y-6 max-w-2xl">
            <div>
              <label class="block text-base font-bold text-slate-800 mb-2">1. Số giờ muốn tắt máy nén chạy bằng Pin lạnh VOX Cool mỗi ngày</label>
              <p class="text-xs text-slate-500 mb-3">Mặc định theo Case I: cắt 5 giờ cao điểm mỗi ngày (17h30 – 22h30).</p>
              <div class="grid grid-cols-3 gap-3">
                <button type="button" onclick="selectShiftHours(5)" id="btn-hrs-5" class="hrs-btn py-3 px-4 rounded-xl border-2 border-emerald-500 bg-emerald-50 text-emerald-800 font-bold text-center">
                  <div class="text-lg">5 giờ/ngày</div>
                  <div class="text-xs font-normal text-emerald-700">Case I (Mặc định)</div>
                </button>
                <button type="button" onclick="selectShiftHours(8)" id="btn-hrs-8" class="hrs-btn py-3 px-4 rounded-xl border-2 border-slate-200 bg-white text-slate-700 font-bold text-center">
                  <div class="text-lg">8 giờ/ngày</div>
                  <div class="text-xs font-normal text-slate-500">Cao điểm + 3h bình thường</div>
                </button>
                <button type="button" onclick="selectShiftHours(10)" id="btn-hrs-10" class="hrs-btn py-3 px-4 rounded-xl border-2 border-slate-200 bg-white text-slate-700 font-bold text-center">
                  <div class="text-lg">10 giờ/ngày</div>
